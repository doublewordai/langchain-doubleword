# ----- Doubleword -----
# Get a key at https://app.doubleword.ai (API Keys page).
DOUBLEWORD_API_KEY=sk-...
DOUBLEWORD_API_BASE=https://api.doubleword.ai/v1

# ----- LangSmith -----
# Sign up at https://smith.langchain.com, then Settings > API Keys.
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=doubleword-langsmith
# Regional / self-hosted endpoint (optional):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# The app under test, and the stronger model that grades it. Override to taste.
APP_MODEL=Qwen/Qwen3.5-9B
JUDGE_MODEL=deepseek-ai/DeepSeek-V4-Pro
